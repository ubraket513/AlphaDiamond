# Ignore an entire directory and all its subfolders
docs/** linguist-vendored
blueprint/** linguist-vendored
.vscode/** linguist-vendored
.github/** linguist-vendored

# Ignore specific files
# path/to/large-file.js linguist-vendored
# Gemfile linguist-vendored

# Ignore all files matching a specific extension (e.g., Jupyter Notebooks or HTML)
# *.ipynb linguist-vendored
# *.html linguist-detectable=false
# *.css linguist-detectable=false

# Canonical topology tables are binary Runtime SDK inputs embedded by Desktop.
data/topology/* binary

# Promoted deployment artifacts are raw typed tensors and topology tables.
models/**/*.f32 binary
models/**/*.i8 binary
models/**/*.i32 binary
models/**/*.json text eol=lf

# GNU make does not accept CRLF recipes.
Makefile text eol=lf

# All supported command-line scripts run under a POSIX shell, including on Windows.
*.sh text eol=lf

