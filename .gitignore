guideline
.github/
.superpowers/
.vscode/
graphify-out/

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
/build-*/
/out/
dist/
/.deps/

# Keep the knowledge graph and report, while leaving extraction caches local.

# Compiled libraries and offline helper caches are generated, never source.
*.so
*.pyd
.pytest_cache/
.ruff_cache/
/runs/
/artifacts/
/.worktrees/

# Training run output: checkpoints, replay and ledgers stay out of Git.
# The step-80 checkpoint below remains as recorded historical Gate-D evidence.
/archive/python-runtime/runs/**
!/archive/python-runtime/runs/soo/
!/archive/python-runtime/runs/soo/cpu8h-soo-20260819/
!/archive/python-runtime/runs/soo/cpu8h-soo-20260819/**

# GPU benchmark runs: keep the ledgers/configs as evidence, leave the
# checkpoints and replay chunks out of Git (regenerate from latest.pt.cpu-backup).
archive/benchmark-runs/**/*.pt
archive/benchmark-runs/**/replay/
archive/benchmark-runs/**/checkpoints/

# Optional bucket downloads live under ignored artifacts/downloads/.
# Archived schema/manifests are documentation, not a mutable storage root.

# Model weights are never source. Tracked exceptions are listed explicitly.
*.pt
*.pth
*.ckpt
*.safetensors
!/archive/python-runtime/runs/soo/cpu8h-soo-20260819/latest.pt

# Agent tooling caches, not project sources
.agents/
.claude/skills/
agent/skills/
.serena/
skills-lock.json
