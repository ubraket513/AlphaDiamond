guideline

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
/build-*/
/out/
dist/
/.deps/

# Keep the knowledge graph and report, while leaving extraction caches local.
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/graph.html
!/graphify-out/manifest.json

# Native self-play extension: built in place, never committed.
*.so
*.pyd
.pytest_cache/
.ruff_cache/
/runs/
/artifacts/
/.worktrees/

# Training run output: checkpoints, replay and ledgers stay out of Git.
# The step-80 checkpoint below remains as recorded historical Gate-D evidence.
/runtime/runs/**
!/runtime/runs/soo/cpu8h-soo-20260819/
!/runtime/runs/soo/cpu8h-soo-20260819/**

# GPU benchmark runs: keep the ledgers/configs as evidence, leave the
# checkpoints and replay chunks out of Git (regenerate from latest.pt.cpu-backup).
az-bench/**/*.pt
az-bench/**/replay/
az-bench/**/checkpoints/

# Bucket synchronisation root: contents are mutable object storage, not source.
/TrainAlphaDiamond/**
!/TrainAlphaDiamond/README.md
!/TrainAlphaDiamond/manifests/
!/TrainAlphaDiamond/manifests/**

# Model weights are never source. Tracked exceptions are listed explicitly.
*.pt
*.pth
*.ckpt
*.safetensors
!/runtime/runs/soo/cpu8h-soo-20260819/latest.pt

# Agent tooling caches, not project sources
.agents/
.claude/skills/
agent/skills/
.serena/
skills-lock.json
