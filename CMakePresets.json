{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "native-ci",
      "displayName": "Native core + tests, no Python",
      "description": "The definition-of-done build: no interpreter, no pybind, no Qt.",
      "binaryDir": "${sourceDir}/build/native-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "DIAMOND_BUILD_NATIVE_TESTS": "ON",
        "DIAMOND_BUILD_QT": "OFF",
        "DIAMOND_BUILD_LIBTORCH": "OFF",
        "DIAMOND_BUILD_MODEL": "OFF",
        "DIAMOND_BUILD_TRAINING": "OFF",
        "DIAMOND_BUILD_QT_SOO": "OFF"
      }
    },
    {
      "name": "native-release",
      "inherits": "native-ci",
      "displayName": "Native release",
      "binaryDir": "${sourceDir}/build/native-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "native-runtime",
      "inherits": "native-ci",
      "displayName": "Native LibTorch runtime without training",
      "binaryDir": "${sourceDir}/build/native-runtime",
      "cacheVariables": {
        "DIAMOND_BUILD_LIBTORCH": "OFF",
        "DIAMOND_BUILD_MODEL": "ON",
        "DIAMOND_BUILD_TRAINING": "OFF"
      }
    },
    {
      "name": "native-gcc-mold",
      "inherits": "native-runtime",
      "displayName": "Native runtime with GCC, Ninja, sccache and mold",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-gcc-mold",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{HOME}/.local/bin/sccache",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=mold"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "native-training",
      "inherits": "native-ci",
      "displayName": "Native LibTorch training",
      "binaryDir": "${sourceDir}/build/native-training",
      "cacheVariables": {
        "DIAMOND_BUILD_LIBTORCH": "OFF",
        "DIAMOND_BUILD_MODEL": "ON",
        "DIAMOND_BUILD_TRAINING": "ON",
        "DIAMOND_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "native-asan",
      "inherits": "native-ci",
      "displayName": "Native core + tests, ASan/UBSan",
      "binaryDir": "${sourceDir}/build/native-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "native-qt",
      "inherits": "native-ci",
      "displayName": "Native Qt + LibTorch application",
      "binaryDir": "${sourceDir}/build/native-qt",
      "cacheVariables": {
        "DIAMOND_BUILD_QT": "ON",
        "DIAMOND_BUILD_LIBTORCH": "OFF",
        "DIAMOND_BUILD_MODEL": "ON",
        "DIAMOND_BUILD_TRAINING": "OFF",
        "DIAMOND_DESKTOP_ENABLE_RATINGS": "ON",
        "DIAMOND_BUILD_QT_SOO": "ON"
      }
    },
    {
      "name": "native-qt-preview",
      "inherits": "native-qt",
      "displayName": "Qt 6.12 development with QML hot reload",
      "binaryDir": "${sourceDir}/build/native-qt-preview",
      "cacheVariables": {
        "DIAMOND_QML_PREVIEW": "ON",
        "Qt6_DIR": "$env{DIAMOND_QT_ROOT}/lib/cmake/Qt6",
        "CMAKE_PREFIX_PATH": "$env{DIAMOND_QT_ROOT};$env{CONDA_PREFIX}/Library"
      }
    },
    {
      "name": "native-package",
      "inherits": "native-qt",
      "displayName": "Native Windows package",
      "binaryDir": "${sourceDir}/build/native-package",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "DIAMOND_QML_PREVIEW": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "native-runtime", "configurePreset": "native-runtime", "configuration": "RelWithDebInfo" },
    { "name": "native-gcc-mold", "configurePreset": "native-gcc-mold", "configuration": "RelWithDebInfo" },
    { "name": "native-ci", "configurePreset": "native-ci", "configuration": "RelWithDebInfo" },
    { "name": "native-release", "configurePreset": "native-release", "configuration": "Release" },
    { "name": "native-training", "configurePreset": "native-training", "configuration": "RelWithDebInfo" },
    { "name": "native-asan", "configurePreset": "native-asan", "configuration": "Debug" },
    { "name": "native-qt", "configurePreset": "native-qt", "configuration": "RelWithDebInfo" },
    { "name": "native-qt-preview", "configurePreset": "native-qt-preview", "configuration": "RelWithDebInfo" },
    { "name": "native-package", "configurePreset": "native-package", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "native-runtime",
      "configurePreset": "native-runtime",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "native-gcc-mold",
      "configurePreset": "native-gcc-mold",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "native-qt-preview",
      "configurePreset": "native-qt-preview",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "native-ci",
      "configurePreset": "native-ci",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "native-training",
      "configurePreset": "native-training",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "native-qt",
      "configurePreset": "native-qt",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "native-package",
      "configurePreset": "native-package",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
