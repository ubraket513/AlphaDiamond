{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core",
      "displayName": "Core",
      "description": "Core engine and search libraries.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DIAMOND_BUILD_MODEL": "OFF",
        "DIAMOND_BUILD_TRAINING": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "core",
      "displayName": "Core release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "runtime",
      "inherits": "core",
      "displayName": "LibTorch runtime",
      "binaryDir": "${sourceDir}/build/runtime",
      "cacheVariables": {
        "DIAMOND_BUILD_MODEL": "ON",
        "DIAMOND_BUILD_TRAINING": "OFF"
      }
    },
    {
      "name": "runtime-linux",
      "inherits": [
        "linux-toolchain",
        "runtime"
      ],
      "displayName": "Linux runtime with GCC 15, sccache and mold",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "training",
      "inherits": "core",
      "displayName": "LibTorch training",
      "binaryDir": "${sourceDir}/build/training",
      "cacheVariables": {
        "DIAMOND_BUILD_MODEL": "ON",
        "DIAMOND_BUILD_TRAINING": "ON",
        "DIAMOND_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "asan",
      "inherits": "core",
      "displayName": "Core with ASan/UBSan",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "training-release",
      "inherits": "training",
      "displayName": "Optimized training",
      "binaryDir": "${sourceDir}/build/training-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-toolchain",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-15",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=mold"
      }
    },
    {
      "name": "core-linux",
      "inherits": [
        "linux-toolchain",
        "core"
      ],
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "training-linux",
      "inherits": [
        "linux-toolchain",
        "training"
      ],
      "binaryDir": "${sourceDir}/build/${presetName}"
    }
  ],
  "buildPresets": [
    {
      "name": "runtime",
      "configurePreset": "runtime",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "runtime-linux",
      "configurePreset": "runtime-linux",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "core",
      "configurePreset": "core",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "training",
      "configurePreset": "training",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "training-release",
      "configurePreset": "training-release",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "core-linux",
      "configurePreset": "core-linux",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "training-linux",
      "configurePreset": "training-linux",
      "configuration": "Debug",
      "jobs": 8
    }
  ]
}
