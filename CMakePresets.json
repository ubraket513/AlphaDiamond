{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-ci",
      "displayName": "Native core, no Python",
      "description": "Portable native core build: no interpreter, no pybind, no Qt.",
      "binaryDir": "${sourceDir}/build/native-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DIAMOND_BUILD_LIBTORCH": "OFF",
        "DIAMOND_BUILD_MODEL": "OFF",
        "DIAMOND_BUILD_TRAINING": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "native-release",
      "inherits": "native-ci",
      "displayName": "Native release",
      "binaryDir": "${sourceDir}/build/native-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native-runtime",
      "inherits": "native-ci",
      "displayName": "Native LibTorch runtime without training",
      "binaryDir": "${sourceDir}/build/native-runtime",
      "cacheVariables": {
        "DIAMOND_BUILD_LIBTORCH": "OFF",
        "DIAMOND_BUILD_MODEL": "ON",
        "DIAMOND_BUILD_TRAINING": "OFF"
      }
    },
    {
      "name": "native-gcc-mold",
      "inherits": "native-runtime",
      "displayName": "Native development runtime with GCC 15, Ninja, sccache and mold",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-gcc-mold",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-15",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{HOME}/.local/bin/sccache",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=mold"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "native-training",
      "inherits": "native-ci",
      "displayName": "Native LibTorch training",
      "binaryDir": "${sourceDir}/build/native-training",
      "cacheVariables": {
        "DIAMOND_BUILD_LIBTORCH": "OFF",
        "DIAMOND_BUILD_MODEL": "ON",
        "DIAMOND_BUILD_TRAINING": "ON",
        "DIAMOND_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "native-asan",
      "inherits": "native-ci",
      "displayName": "Native core, ASan/UBSan",
      "binaryDir": "${sourceDir}/build/native-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "native-training-release",
      "inherits": "native-training",
      "displayName": "Optimized final native training",
      "binaryDir": "${sourceDir}/build/native-training-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native-linux-toolchain",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-15",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=mold"
      }
    },
    {
      "name": "native-ci-linux",
      "inherits": [
        "native-linux-toolchain",
        "native-ci"
      ],
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "native-training-linux",
      "inherits": [
        "native-linux-toolchain",
        "native-training"
      ],
      "binaryDir": "${sourceDir}/build/${presetName}"
    }
  ],
  "buildPresets": [
    {
      "name": "native-runtime",
      "configurePreset": "native-runtime",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "native-gcc-mold",
      "configurePreset": "native-gcc-mold",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "native-ci",
      "configurePreset": "native-ci",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "native-training",
      "configurePreset": "native-training",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "native-training-release",
      "configurePreset": "native-training-release",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "native-ci-linux",
      "configurePreset": "native-ci-linux",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "native-training-linux",
      "configurePreset": "native-training-linux",
      "configuration": "Debug",
      "jobs": 8
    }
  ]
}
