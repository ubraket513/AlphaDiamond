@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
macro(_alphadiamond_incompatible reason)
    set(AlphaDiamondEngine_FOUND FALSE)
    set(AlphaDiamondEngine_NOT_FOUND_MESSAGE "${reason}")
    return()
endmacro()

set_and_check(AlphaDiamondEngine_DATA_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/AlphaDiamondEngine")
set_and_check(AlphaDiamondEngine_TOPOLOGY_DIR "${AlphaDiamondEngine_DATA_DIR}/topology")
set_and_check(AlphaDiamondEngine_MANIFEST "${AlphaDiamondEngine_DATA_DIR}/manifest.json")
file(READ "${AlphaDiamondEngine_MANIFEST}" _ad_manifest)
foreach(_field sdk_version platform architecture pointer_size compiler compiler_version configuration crt torch_version torch_variant torch_abi)
    string(JSON _ad_${_field} ERROR_VARIABLE _ad_error GET "${_ad_manifest}" "${_field}")
    if(_ad_error)
        _alphadiamond_incompatible("AlphaDiamondEngine manifest is invalid: ${_field}")
    endif()
endforeach()
if(NOT _ad_sdk_version STREQUAL "@ALPHADIAMOND_ENGINE_VERSION@")
    _alphadiamond_incompatible("AlphaDiamondEngine manifest SDK version mismatch")
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL _ad_platform OR
   NOT CMAKE_SYSTEM_PROCESSOR STREQUAL _ad_architecture OR
   NOT CMAKE_SIZEOF_VOID_P STREQUAL _ad_pointer_size)
    _alphadiamond_incompatible("AlphaDiamondEngine platform/architecture mismatch")
endif()
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL _ad_compiler OR
   NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL _ad_compiler_version)
    _alphadiamond_incompatible("AlphaDiamondEngine compiler ABI mismatch; rebuild SDK with this compiler")
endif()
if(CMAKE_CONFIGURATION_TYPES)
    foreach(_config IN LISTS CMAKE_CONFIGURATION_TYPES)
        if(NOT _config STREQUAL _ad_configuration)
            _alphadiamond_incompatible("AlphaDiamondEngine configuration mismatch: SDK is ${_ad_configuration}; set CMAKE_CONFIGURATION_TYPES to that configuration")
        endif()
    endforeach()
elseif(NOT CMAKE_BUILD_TYPE STREQUAL _ad_configuration)
    _alphadiamond_incompatible("AlphaDiamondEngine configuration mismatch: SDK is ${_ad_configuration}; set CMAKE_BUILD_TYPE")
endif()
if(MSVC)
    set(_ad_consumer_crt "${CMAKE_MSVC_RUNTIME_LIBRARY}")
    if(NOT _ad_consumer_crt)
        set(_ad_consumer_crt "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    endif()
    if(NOT _ad_consumer_crt STREQUAL _ad_crt)
        _alphadiamond_incompatible("AlphaDiamondEngine MSVC CRT mismatch")
    endif()
endif()
if(DEFINED CMAKE_CXX_STANDARD AND
   ((MSVC AND CMAKE_CXX_STANDARD LESS 23) OR
    (NOT MSVC AND CMAKE_CXX_STANDARD LESS 26)))
    _alphadiamond_incompatible("AlphaDiamondEngine requires C++26")
endif()
if(MSVC)
    include(CheckCXXCompilerFlag)
    check_cxx_compiler_flag("/std:c++latest" _ad_has_latest)
    if(NOT _ad_has_latest)
        _alphadiamond_incompatible("AlphaDiamondEngine requires MSVC /std:c++latest")
    endif()
elseif(CMAKE_VERSION VERSION_LESS 3.30 OR NOT "cxx_std_26" IN_LIST CMAKE_CXX_COMPILE_FEATURES)
    _alphadiamond_incompatible("AlphaDiamondEngine requires CMake/compiler support for C++26")
endif()
find_dependency(Threads)
if(@ALPHADIAMOND_ENGINE_HAS_MODEL@)
    find_dependency(Torch @Torch_VERSION@ EXACT CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/AlphaDiamondEngineTorch.cmake")
    if(NOT AlphaDiamondEngine_TORCH_VARIANT STREQUAL _ad_torch_variant OR
       NOT AlphaDiamondEngine_TORCH_ABI STREQUAL _ad_torch_abi)
        _alphadiamond_incompatible("AlphaDiamondEngine Torch variant/ABI mismatch")
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND
       "${CMAKE_CXX_FLAGS}" MATCHES "_GLIBCXX_USE_CXX11_ABI=([01])")
        if(NOT "cxx11-${CMAKE_MATCH_1}" STREQUAL _ad_torch_abi)
            _alphadiamond_incompatible("AlphaDiamondEngine consumer C++ ABI mismatch")
        endif()
    endif()
    foreach(_field TORCH_ABI TORCH_VARIANT)
        if(DEFINED AlphaDiamondEngine_EXPECT_${_field} AND
           NOT AlphaDiamondEngine_EXPECT_${_field} STREQUAL AlphaDiamondEngine_${_field})
            _alphadiamond_incompatible("AlphaDiamondEngine requested ${_field} mismatch")
        endif()
    endforeach()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/AlphaDiamondEngineTargets.cmake")
set(AlphaDiamondEngine_Runtime_FOUND @ALPHADIAMOND_ENGINE_HAS_MODEL@)
check_required_components(AlphaDiamondEngine)
