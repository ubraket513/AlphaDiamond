# Runs after all Runtime files have been installed, including generated data.
get_filename_component(_ad_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}" ABSOLUTE)
set(_ad_data "${_ad_prefix}/@CMAKE_INSTALL_DATADIR@/AlphaDiamondEngine")
file(MAKE_DIRECTORY "${_ad_data}")
set(_ad_manifest "{}")
macro(_ad_string key value)
    string(JSON _ad_manifest SET "${_ad_manifest}" "${key}" "\"${value}\"")
endmacro()
_ad_string(sdk_version "@ALPHADIAMOND_ENGINE_VERSION@")
_ad_string(source_sha "@ALPHADIAMOND_ENGINE_SOURCE_SHA@")
string(JSON _ad_manifest SET "${_ad_manifest}" source_dirty @ALPHADIAMOND_ENGINE_SOURCE_DIRTY@)
_ad_string(platform "@CMAKE_SYSTEM_NAME@")
_ad_string(architecture "@CMAKE_SYSTEM_PROCESSOR@")
_ad_string(pointer_size "@CMAKE_SIZEOF_VOID_P@")
_ad_string(compiler "@CMAKE_CXX_COMPILER_ID@")
_ad_string(compiler_version "@CMAKE_CXX_COMPILER_VERSION@")
_ad_string(configuration "${CMAKE_INSTALL_CONFIG_NAME}")
_ad_string(crt "@ALPHADIAMOND_ENGINE_CRT@")
_ad_string(torch_version "@Torch_VERSION@")
_ad_string(torch_variant "@AlphaDiamondEngine_TORCH_VARIANT@")
_ad_string(torch_abi "@AlphaDiamondEngine_TORCH_ABI@")
string(JSON _ad_manifest SET "${_ad_manifest}" cxx_standard 26)
string(JSON _ad_manifest SET "${_ad_manifest}" contracts
    "{\"artifact_format\":3,\"families\":[\"soo\",\"min\"],\"encoders\":[\"diamond-camp-relative-v1\",\"diamond-camp-relative-goals-v2\"],\"topology\":\"diamond73-v1\",\"action_space\":\"diamond73-srcdst-v1\"}")
string(JSON _ad_manifest SET "${_ad_manifest}" files "{}")
file(GLOB_RECURSE _ad_files LIST_DIRECTORIES FALSE RELATIVE "${_ad_prefix}" "${_ad_prefix}/*")
list(SORT _ad_files)
foreach(_file IN LISTS _ad_files)
    if(_file MATCHES "(^|/)manifest.json$")
        continue()
    endif()
    file(SHA256 "${_ad_prefix}/${_file}" _digest)
    string(JSON _ad_manifest SET "${_ad_manifest}" files "${_file}" "\"${_digest}\"")
endforeach()
file(WRITE "${_ad_data}/manifest.json" "${_ad_manifest}\n")
