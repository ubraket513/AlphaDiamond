include("${AD_INPUT_FILE}")
get_filename_component(_ad_state_dir "${AD_INPUT_FILE}" DIRECTORY)
function(_ad_source_state result)
    execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${AD_SOURCE_ROOT}"
        OUTPUT_VARIABLE _sha OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _git_status)
    if(NOT _git_status EQUAL 0)
        message(FATAL_ERROR "SDK provenance requires a Git source SHA")
    endif()
    execute_process(COMMAND git status --porcelain --untracked-files=normal
        WORKING_DIRECTORY "${AD_SOURCE_ROOT}" OUTPUT_VARIABLE _dirty RESULT_VARIABLE _git_status)
    if(NOT _git_status EQUAL 0)
        message(FATAL_ERROR "SDK provenance could not read source status")
    endif()
    set(_content)
    foreach(_input IN LISTS AD_SOURCE_INPUTS)
        if(NOT EXISTS "${_input}")
            message(FATAL_ERROR "SDK source input is missing: ${_input}")
        endif()
        file(RELATIVE_PATH _name "${AD_SOURCE_ROOT}" "${_input}")
        file(SHA256 "${_input}" _digest)
        string(APPEND _content "${_name}:${_digest}\n")
    endforeach()
    string(SHA256 _content_digest "${_content}")
    set(_state "{}")
    string(JSON _state SET "${_state}" source_sha "\"${_sha}\"")
    string(JSON _state SET "${_state}" source_content_sha256 "\"${_content_digest}\"")
    if(_dirty)
        string(JSON _state SET "${_state}" source_dirty true)
    else()
        string(JSON _state SET "${_state}" source_dirty false)
    endif()
    set(${result} "${_state}" PARENT_SCOPE)
endfunction()
_ad_source_state(_ad_current_source)
set(_ad_payload_files ${AD_BINARY_INPUTS})
foreach(_directory IN LISTS AD_DATA_DIRS)
    file(GLOB_RECURSE _data LIST_DIRECTORIES FALSE "${_directory}/*")
    list(APPEND _ad_payload_files ${_data})
endforeach()
list(SORT _ad_payload_files)
if(AD_MODE STREQUAL begin)
    # A partial/failed build cannot leave an earlier stamp valid.
    file(REMOVE "${_ad_state_dir}/stamp.json")
    file(WRITE "${_ad_state_dir}/begin.json.tmp" "${_ad_current_source}")
    file(RENAME "${_ad_state_dir}/begin.json.tmp" "${_ad_state_dir}/begin.json")
elseif(AD_MODE STREQUAL stamp)
    file(READ "${_ad_state_dir}/begin.json" _ad_begin_source)
    if(NOT _ad_current_source STREQUAL _ad_begin_source)
        message(FATAL_ERROR "SDK source changed during its build; rebuild engine_sdk_provenance")
    endif()
    set(_ad_stamp "{}")
    string(JSON _ad_stamp SET "${_ad_stamp}" source "${_ad_begin_source}")
    string(JSON _ad_stamp SET "${_ad_stamp}" binaries "{}")
    foreach(_binary IN LISTS _ad_payload_files)
        file(SHA256 "${_binary}" _digest)
        string(JSON _ad_stamp SET "${_ad_stamp}" binaries "${_binary}" "\"${_digest}\"")
    endforeach()
    file(WRITE "${_ad_state_dir}/stamp.json.tmp" "${_ad_stamp}")
    file(RENAME "${_ad_state_dir}/stamp.json.tmp" "${_ad_state_dir}/stamp.json")
elseif(AD_MODE STREQUAL validate)
    if(NOT EXISTS "${_ad_state_dir}/stamp.json")
        message(FATAL_ERROR "SDK build provenance is missing; build engine_sdk_provenance before installing Runtime")
    endif()
    file(READ "${_ad_state_dir}/stamp.json" _ad_stamp)
    string(JSON AD_BUILD_SOURCE GET "${_ad_stamp}" source)
    if(NOT _ad_current_source STREQUAL AD_BUILD_SOURCE)
        message(FATAL_ERROR "SDK source changed since its build; rebuild engine_sdk_provenance before installing Runtime")
    endif()
    string(JSON _expected_count LENGTH "${_ad_stamp}" binaries)
    list(LENGTH _ad_payload_files _actual_count)
    if(NOT _actual_count EQUAL _expected_count)
        message(FATAL_ERROR "SDK binary changed since its build: payload file list changed")
    endif()
    foreach(_binary IN LISTS _ad_payload_files)
        file(SHA256 "${_binary}" _actual)
        string(JSON _expected GET "${_ad_stamp}" binaries "${_binary}")
        if(NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "SDK binary changed since its build: ${_binary}; rebuild engine_sdk_provenance")
        endif()
    endforeach()
else()
    message(FATAL_ERROR "Unknown SDK provenance mode: ${AD_MODE}")
endif()
