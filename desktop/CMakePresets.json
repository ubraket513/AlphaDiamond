{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "desktop-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "DIAMOND_ENGINE_SDK_PREFIX": "$env{DIAMOND_ENGINE_SDK_PREFIX}",
        "CMAKE_PREFIX_PATH": "$env{CMAKE_PREFIX_PATH}",
        "DIAMOND_BUILD_QT_SOO": "ON",
        "DIAMOND_DESKTOP_ENABLE_RATINGS": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF"
      }
    },
    {
      "name": "desktop-dev",
      "inherits": "desktop-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF"
      }
    },
    {
      "name": "desktop-linux",
      "inherits": "desktop-dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-15",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g1 -pipe -fno-lto",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold -fno-lto",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold -fno-lto"
      }
    },
    {
      "name": "desktop-preview",
      "inherits": "desktop-dev",
      "cacheVariables": {
        "DIAMOND_QML_PREVIEW": "ON"
      }
    },
    {
      "name": "desktop-preview-linux",
      "inherits": [
        "desktop-linux",
        "desktop-preview"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "desktop-release",
      "configurePreset": "desktop-release"
    },
    {
      "name": "desktop-dev",
      "configurePreset": "desktop-dev"
    },
    {
      "name": "desktop-linux",
      "configurePreset": "desktop-linux"
    },
    {
      "name": "desktop-preview",
      "configurePreset": "desktop-preview"
    },
    {
      "name": "desktop-preview-linux",
      "configurePreset": "desktop-preview-linux"
    }
  ],
  "testPresets": [
    {
      "name": "desktop-release",
      "configurePreset": "desktop-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "OMP_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1"
      }
    },
    {
      "name": "desktop-dev",
      "configurePreset": "desktop-dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "OMP_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1"
      }
    },
    {
      "name": "desktop-linux",
      "configurePreset": "desktop-linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "OMP_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1"
      }
    },
    {
      "name": "desktop-preview",
      "configurePreset": "desktop-preview",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "OMP_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1"
      }
    },
    {
      "name": "desktop-preview-linux",
      "configurePreset": "desktop-preview-linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "OMP_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1"
      }
    }
  ]
}
