function(verify_engine_sdk lock_path manifest_path prefix archive)
    if(NOT EXISTS "${lock_path}" OR NOT EXISTS "${manifest_path}")
        message(FATAL_ERROR "Engine SDK lock or manifest is missing")
    endif()
    file(READ "${lock_path}" lock)
    file(READ "${manifest_path}" manifest)
    string(JSON schema GET "${lock}" schema)
    if(NOT schema EQUAL 1)
        message(FATAL_ERROR "Unsupported Engine SDK lock schema")
    endif()
    string(JSON count LENGTH "${lock}" entries)
    set(matches 0)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON entry GET "${lock}" entries ${index})
            set(match TRUE)
            foreach(pair IN ITEMS "platform;platform" "arch;architecture" "compiler;compiler" "configuration;configuration")
                list(GET pair 0 lock_key)
                list(GET pair 1 manifest_key)
                string(JSON expected GET "${entry}" "${lock_key}")
                string(JSON actual GET "${manifest}" "${manifest_key}")
                if(NOT expected STREQUAL actual)
                    set(match FALSE)
                endif()
            endforeach()
            if(match)
                math(EXPR matches "${matches} + 1")
                set(selected "${entry}")
            endif()
        endforeach()
    endif()
    if(NOT matches EQUAL 1)
        message(FATAL_ERROR "Engine SDK manifest matches ${matches} lock entries; expected exactly one")
    endif()
    foreach(pair IN ITEMS "sdk_version;sdk_version" "source_commit;source_sha" "source_dirty;source_dirty" "torch_version;torch_version" "torch_variant;torch_variant" "cxx_abi;torch_abi" "compiler_version;compiler_version")
        list(GET pair 0 lock_key)
        list(GET pair 1 manifest_key)
        string(JSON expected GET "${selected}" "${lock_key}")
        string(JSON actual GET "${manifest}" "${manifest_key}")
        if(NOT expected STREQUAL actual)
            message(FATAL_ERROR "Engine SDK ${manifest_key} differs from lock")
        endif()
    endforeach()
    string(JSON expected_manifest GET "${selected}" manifest_sha256)
    file(SHA256 "${manifest_path}" actual_manifest)
    if(NOT actual_manifest STREQUAL expected_manifest)
        message(FATAL_ERROR "Engine SDK manifest digest differs from lock")
    endif()
    string(JSON archive_sha GET "${selected}" archive_sha256)
    if(NOT archive_sha MATCHES "^[0-9a-f]+$" OR NOT archive_sha MATCHES "^................................................................$")
        message(FATAL_ERROR "Engine SDK lock requires an archive SHA-256")
    endif()
    if(archive)
        file(SHA256 "${archive}" actual_archive)
        if(NOT actual_archive STREQUAL archive_sha)
            message(FATAL_ERROR "Engine SDK archive digest differs from lock")
        endif()
    endif()
    string(JSON platform GET "${selected}" platform)
    string(JSON arch GET "${selected}" arch)
    string(JSON compiler GET "${selected}" compiler)
    string(JSON compiler_version GET "${selected}" compiler_version)
    string(JSON configuration GET "${selected}" configuration)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL platform OR NOT CMAKE_SYSTEM_PROCESSOR STREQUAL arch OR
       NOT CMAKE_CXX_COMPILER_ID STREQUAL compiler OR NOT CMAKE_CXX_COMPILER_VERSION STREQUAL compiler_version OR
       (CMAKE_BUILD_TYPE AND NOT CMAKE_BUILD_TYPE STREQUAL configuration))
        message(FATAL_ERROR "Current compiler, platform, architecture, or configuration differs from SDK lock")
    endif()
    string(JSON file_count LENGTH "${manifest}" files)
    if(file_count LESS 1)
        message(FATAL_ERROR "Engine SDK manifest has no files")
    endif()
    math(EXPR file_last "${file_count} - 1")
    foreach(index RANGE 0 ${file_last})
        string(JSON relative MEMBER "${manifest}" files ${index})
        if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)")
            message(FATAL_ERROR "Invalid SDK manifest path: ${relative}")
        endif()
        string(JSON expected GET "${manifest}" files "${relative}")
        if(NOT EXISTS "${prefix}/${relative}")
            message(FATAL_ERROR "SDK file missing: ${relative}")
        endif()
        file(SHA256 "${prefix}/${relative}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "SDK file digest differs: ${relative}")
        endif()
    endforeach()
endfunction()
