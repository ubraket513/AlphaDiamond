cmake_minimum_required(VERSION 3.21)

# Exercise generated compile/link commands, rather than only preset text. Moving
# development flags onto all configurations would make the Release case fail.
foreach(required SOURCE_DIR BINARY_DIR CXX_COMPILER)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
find_program(NINJA_EXECUTABLE ninja REQUIRED)
file(REMOVE_RECURSE "${BINARY_DIR}")
file(MAKE_DIRECTORY "${BINARY_DIR}/source")
file(WRITE "${BINARY_DIR}/source/main.cpp" "int main() { return 0; }\n")
file(WRITE "${BINARY_DIR}/source/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.21)
project(development_toolchain_probe LANGUAGES CXX)
include(\"${SOURCE_DIR}/cmake/DevelopmentToolchain.cmake\")
add_executable(probe main.cpp)
enable_testing()
add_test(NAME run_probe COMMAND probe)
")

foreach(configuration Default Debug Release)
    set(build "${BINARY_DIR}/${configuration}")
    set(configure "${CMAKE_COMMAND}" -S "${BINARY_DIR}/source" -B "${build}" -G Ninja
        "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}"
        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)
    if(NOT configuration STREQUAL "Default")
        list(APPEND configure "-DCMAKE_BUILD_TYPE=${configuration}")
    endif()
    if(CXX_LAUNCHER)
        list(APPEND configure "-DCMAKE_CXX_COMPILER_LAUNCHER=${CXX_LAUNCHER}")
    endif()
    if(EXE_LINKER_FLAGS)
        list(APPEND configure "-DCMAKE_EXE_LINKER_FLAGS=${EXE_LINKER_FLAGS}")
    endif()
    execute_process(COMMAND ${configure} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${configuration} configure failed:\n${output}\n${error}")
    endif()
    file(READ "${build}/compile_commands.json" commands)
    file(READ "${build}/build.ninja" build_rules)
    file(READ "${build}/CMakeFiles/rules.ninja" rules)
    file(READ "${build}/CMakeCache.txt" cache)
    if(NOT commands MATCHES "-pipe")
        message(FATAL_ERROR "GNU compile command lacks -pipe: ${commands}")
    endif()
    if(commands MATCHES "-flto" OR build_rules MATCHES "-flto" OR rules MATCHES "-flto")
        message(FATAL_ERROR "${configuration} unexpectedly enables LTO")
    endif()
    if(NOT cache MATCHES "CMAKE_INTERPROCEDURAL_OPTIMIZATION:BOOL=OFF")
        message(FATAL_ERROR "${configuration} cache does not default IPO to OFF")
    endif()
    if(NOT configuration STREQUAL "Release")
        if(NOT cache MATCHES "CMAKE_BUILD_TYPE:STRING=Debug")
            message(FATAL_ERROR "${configuration} did not select Debug in the actual cache")
        endif()
        if(NOT commands MATCHES "-O0" OR NOT commands MATCHES "-g1"
                OR commands MATCHES "-O[123szg]")
            message(FATAL_ERROR "Debug compile command violates development flags: ${commands}")
        endif()
    elseif(NOT commands MATCHES "-O3" OR commands MATCHES "-O0")
        message(FATAL_ERROR "Explicit Release must retain compiler optimization: ${commands}")
    endif()
    if(CXX_LAUNCHER)
        string(FIND "${rules}\n${build_rules}" "${CXX_LAUNCHER}" launcher_offset)
        string(FIND "${cache}" "CMAKE_CXX_COMPILER_LAUNCHER:UNINITIALIZED=${CXX_LAUNCHER}" cache_offset)
        if(launcher_offset EQUAL -1 OR cache_offset EQUAL -1)
            message(FATAL_ERROR "Compiler launcher absent from generated command or cache")
        endif()
    endif()
    if(EXE_LINKER_FLAGS MATCHES "-fuse-ld=mold" AND NOT build_rules MATCHES "-fuse-ld=mold")
        message(FATAL_ERROR "mold missing from generated link command")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --parallel 8 --verbose
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${configuration} compile/link failed:\n${output}\n${error}")
    endif()
    if(CXX_LAUNCHER)
        string(FIND "${output}" "${CXX_LAUNCHER}" launcher_offset)
        if(launcher_offset EQUAL -1)
            message(FATAL_ERROR "Build did not execute compiler launcher: ${output}")
        endif()
    endif()
    if(EXE_LINKER_FLAGS MATCHES "-fuse-ld=mold" AND NOT output MATCHES "-fuse-ld=mold")
        message(FATAL_ERROR "Build did not execute mold linker: ${output}")
    endif()
    execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${build}" --parallel 12 --output-on-failure
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${configuration} executable failed:\n${output}\n${error}")
    endif()
endforeach()
