cmake_minimum_required(VERSION 3.21)

# Exercise the complete Engine runtime graph to detect accidental training edges.
foreach(required SOURCE_DIR BINARY_DIR CXX_COMPILER)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "runtime boundary test requires ${required}")
    endif()
endforeach()
set(configure_args -S "${SOURCE_DIR}" -DCMAKE_CXX_COMPILER:FILEPATH=${CXX_COMPILER}
    -DDIAMOND_BUILD_LIBTORCH_PROBE=OFF -DDIAMOND_BUILD_NATIVE_TESTS=ON
    -DBUILD_TESTING=ON -DCMAKE_BUILD_TYPE=Release)
if(DEFINED GENERATOR)
    list(APPEND configure_args -G "${GENERATOR}")
endif()
if(CXX_LAUNCHER)
    list(APPEND configure_args "-DCMAKE_CXX_COMPILER_LAUNCHER:FILEPATH=${CXX_LAUNCHER}")
endif()
if(EXE_LINKER_FLAGS)
    list(APPEND configure_args "-DCMAKE_EXE_LINKER_FLAGS:STRING=${EXE_LINKER_FLAGS}")
endif()
if(TORCH_CUDA_ARCH_LIST)
    list(APPEND configure_args "-DTORCH_CUDA_ARCH_LIST:STRING=${TORCH_CUDA_ARCH_LIST}")
endif()
foreach(package Torch)
    if(DEFINED ${package}_DIR AND NOT "${${package}_DIR}" STREQUAL "")
        list(APPEND configure_args "-D${package}_DIR:PATH=${${package}_DIR}")
    endif()
endforeach()

function(configure_case name expect_success)
    set(case_dir "${BINARY_DIR}/${name}")
    file(REMOVE_RECURSE "${case_dir}")
    file(MAKE_DIRECTORY "${case_dir}/.cmake/api/v1/query")
    file(WRITE "${case_dir}/.cmake/api/v1/query/codemodel-v2" "")
    execute_process(COMMAND "${CMAKE_COMMAND}" ${configure_args} -B "${case_dir}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(expect_success AND NOT result EQUAL 0)
        message(FATAL_ERROR "${name} configure failed:\n${output}\n${errors}")
    elseif(NOT expect_success)
        if(result EQUAL 0 OR NOT "${output}${errors}" MATCHES "DIAMOND_BUILD_TRAINING requires DIAMOND_BUILD_MODEL")
            message(FATAL_ERROR "Invalid training/model combination was not clearly rejected:\n${output}\n${errors}")
        endif()
        return()
    endif()
    file(GLOB codemodels "${case_dir}/.cmake/api/v1/reply/codemodel-v2-*.json")
    list(LENGTH codemodels count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "${name}: missing unique CMake codemodel reply")
    endif()
    list(GET codemodels 0 codemodel_path)
    file(READ "${codemodel_path}" codemodel)
    string(JSON count LENGTH "${codemodel}" configurations 0 targets)
    math(EXPR last "${count} - 1")
    set(names)
    foreach(index RANGE ${last})
        string(JSON target_name GET "${codemodel}" configurations 0 targets ${index} name)
        list(APPEND names "${target_name}")
        if(name STREQUAL "runtime" AND target_name MATCHES "^(diamond_model|diamond_artifact|diamond_rating|alphadiamond-rating-sync)$")
            string(JSON json_file GET "${codemodel}" configurations 0 targets ${index} jsonFile)
            file(READ "${case_dir}/.cmake/api/v1/reply/${json_file}" target_json)
            if(target_json MATCHES "diamond_(pipeline|native_pipeline|training|orchestration|release)::")
                message(FATAL_ERROR "${target_name} has a forbidden replay/training dependency")
            endif()
        endif()
    endforeach()
    if(name STREQUAL "runtime")
        foreach(target diamond_model diamond_support diamond_artifact diamond_rating alphadiamond-rating-sync
                model_index_test rating_fixture_test rating_registry_test rating_store_transaction_test rating_sync_test)
            if(NOT target IN_LIST names)
                message(FATAL_ERROR "Runtime configuration is missing ${target}")
            endif()
        endforeach()
        foreach(target diamond_training diamond_native_pipeline diamond_orchestration diamond_release
                alphadiamond-train alphadiamond-checkpoint alphadiamond-release alphadiamond-pipeline
                alphadiamond-min-probe training_step_benchmark checkpoint_benchmark replay_benchmark)
            if(target IN_LIST names)
                message(FATAL_ERROR "Runtime configuration unexpectedly defines ${target}")
            endif()
        endforeach()
    else()
        foreach(target diamond_model diamond_training diamond_native_pipeline diamond_orchestration alphadiamond-train)
            if(NOT target IN_LIST names)
                message(FATAL_ERROR "Legacy LibTorch umbrella is missing ${target}")
            endif()
        endforeach()
    endif()
endfunction()

configure_case(runtime TRUE -DDIAMOND_BUILD_LIBTORCH=OFF -DDIAMOND_BUILD_MODEL=ON
    -DDIAMOND_BUILD_TRAINING=OFF -DDIAMOND_BUILD_BENCHMARKS=ON)
configure_case(invalid FALSE -DDIAMOND_BUILD_LIBTORCH=OFF -DDIAMOND_BUILD_MODEL=OFF
    -DDIAMOND_BUILD_TRAINING=ON)
configure_case(legacy TRUE -DDIAMOND_BUILD_LIBTORCH=ON -DDIAMOND_BUILD_MODEL=OFF
    -DDIAMOND_BUILD_TRAINING=OFF)
