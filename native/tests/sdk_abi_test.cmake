cmake_minimum_required(VERSION 3.30)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(STATUS "The ABI-0 regression applies to Linux libstdc++")
    return()
endif()
set(_root "${TEST_ROOT}/sdk-abi")
file(MAKE_DIRECTORY "${_root}")
file(WRITE "${_root}/main.cpp" "#include <diamond_support/json.hpp>\n#include <string>\nint main() { return diamond_support::canonical_json(diamond_support::parse_json(\"{\\\"abi\\\":0}\")) == std::string(\"{\\\"abi\\\":0}\") ? 0 : 1; }\n")
file(WRITE "${_root}/empty.cpp" "int sdk_unused_symbol() { return 0; }\n")
file(WRITE "${_root}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.30)
project(SdkAbiRegression LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 26)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(AlphaDiamondEngine_TORCH_ABI cxx11-0)
foreach(name soo_core soo_search diamond_artifact diamond_rating diamond_model)
    add_library(${name} STATIC empty.cpp)
    add_library(alphadiamond::${name} ALIAS ${name})
endforeach()
add_library(diamond_support STATIC "${ENGINE_SOURCE}/native/src/json.cpp")
target_include_directories(diamond_support PUBLIC "${ENGINE_SOURCE}/native/include")
# Exercise the production package wiring, while building only the real JSON
# library and probe. No ABI-0 Torch binaries are needed by this boundary test.
set(PROJECT_SOURCE_DIR "${ENGINE_SOURCE}")
set(BUILD_TESTING OFF)
include("${ENGINE_SOURCE}/cmake/InstallEngineSdk.cmake")
foreach(name soo_core soo_search diamond_support diamond_artifact diamond_rating diamond_model)
    get_target_property(definitions ${name} INTERFACE_COMPILE_DEFINITIONS)
    if(NOT "_GLIBCXX_USE_CXX11_ABI=0" IN_LIST definitions)
        message(FATAL_ERROR "SDK ABI missing on ${name}")
    endif()
endforeach()
add_executable(probe main.cpp)
target_link_libraries(probe PRIVATE diamond_support)
enable_testing()
add_test(NAME abi0_json_boundary COMMAND probe)
]=])
set(_configure "${CMAKE_COMMAND}" -S "${_root}" -B "${_root}/build" -G Ninja
    "-DENGINE_SOURCE=${SOURCE_DIR}" "-DCMAKE_CXX_COMPILER=${COMPILER}"
    "-DCMAKE_CXX_COMPILER_LAUNCHER=${COMPILER_LAUNCHER}"
    "-DCMAKE_CXX_FLAGS=-O0 -g1 -pipe -fno-lto" "-DCMAKE_EXE_LINKER_FLAGS=-fuse-ld=mold -fno-lto")
foreach(_command configure build test)
    if(_command STREQUAL configure)
        set(_args ${_configure})
    elseif(_command STREQUAL build)
        set(_args "${CMAKE_COMMAND}" --build "${_root}/build" --target probe --parallel 8)
    else()
        set(_args "${CMAKE_CTEST_COMMAND}" --test-dir "${_root}/build" --parallel 8 --output-on-failure)
    endif()
    execute_process(COMMAND ${_args} RESULT_VARIABLE _status OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(NOT _status EQUAL 0)
        message(FATAL_ERROR "ABI-0 ${_command} failed:\n${_out}\n${_err}")
    endif()
endforeach()
