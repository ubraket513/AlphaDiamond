cmake_minimum_required(VERSION 3.30)
# May run from CTest, or independently after moving the producer checkout/build
# away: pass SDK_PREFIX and CONSUMER_SOURCE copied outside those directories.
if(NOT CONFIG)
    set(CONFIG Release)
endif()
if(NOT JOBS)
    if(DEFINED ENV{CMAKE_BUILD_PARALLEL_LEVEL})
        set(JOBS "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}")
    else()
        set(JOBS 8)
    endif()
endif()
if(NOT TEST_ROOT)
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _id)
    if(DEFINED ENV{TMPDIR})
        set(_temp "$ENV{TMPDIR}")
    elseif(WIN32)
        set(_temp "$ENV{TEMP}")
    else()
        set(_temp /tmp)
    endif()
    set(TEST_ROOT "${_temp}/alphadiamond-sdk-${_id}")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
function(run_checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE _status OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(NOT _status EQUAL 0)
        message(FATAL_ERROR "SDK command failed (${_status}): ${ARGV}\n${_out}\n${_err}")
    endif()
endfunction()

if(NOT SDK_PREFIX)
    if(NOT BUILD_DIR OR NOT SOURCE_DIR)
        message(FATAL_ERROR "Pass SDK_PREFIX/CONSUMER_SOURCE or BUILD_DIR/SOURCE_DIR")
    endif()
    set(SDK_PREFIX "${TEST_ROOT}/installed")
    run_checked("${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${SDK_PREFIX}"
        --component Runtime --config "${CONFIG}")
endif()
if(NOT CONSUMER_SOURCE)
    set(CONSUMER_SOURCE "${SOURCE_DIR}/native/tests/sdk_consumer")
endif()
file(COPY "${SDK_PREFIX}/" DESTINATION "${TEST_ROOT}/relocated")
file(COPY "${CONSUMER_SOURCE}/" DESTINATION "${TEST_ROOT}/consumer")
set(_prefix "${TEST_ROOT}/relocated")

# Verify every shipped file; the manifest itself cannot hash itself.
file(READ "${_prefix}/share/AlphaDiamondEngine/manifest.json" _manifest)
string(JSON _count LENGTH "${_manifest}" files)
if(_count LESS 1)
    message(FATAL_ERROR "SDK manifest contains no file digests")
endif()
math(EXPR _last "${_count} - 1")
foreach(_index RANGE ${_last})
    string(JSON _file MEMBER "${_manifest}" files ${_index})
    string(JSON _expected GET "${_manifest}" files "${_file}")
    file(SHA256 "${_prefix}/${_file}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "SDK file digest mismatch: ${_file}")
    endif()
endforeach()
foreach(_forbidden include/diamond_training include/diamond_pipeline
        include/diamond_orchestration/coordinator.hpp
        bin/alphadiamond-train bin/alphadiamond-train.exe)
    if(EXISTS "${_prefix}/${_forbidden}")
        message(FATAL_ERROR "Training surface leaked into SDK: ${_forbidden}")
    endif()
endforeach()
if(NOT EXISTS "${_prefix}/bin/alphadiamond-rating-sync${CMAKE_EXECUTABLE_SUFFIX}" AND
   NOT EXISTS "${_prefix}/bin/alphadiamond-rating-sync.exe")
    message(FATAL_ERROR "Runtime SDK is missing rating-sync tool")
endif()
file(GLOB_RECURSE _configs "${_prefix}/*.cmake")
foreach(_file IN LISTS _configs)
    file(READ "${_file}" _contents)
    foreach(_old IN ITEMS "${SOURCE_DIR}" "${BUILD_DIR}" "${PRODUCER_TORCH_PREFIX}")
        if(_old)
            string(FIND "${_contents}" "${_old}" _found)
            if(NOT _found EQUAL -1)
                message(FATAL_ERROR "SDK captures producer path ${_old}: ${_file}")
            endif()
        endif()
    endforeach()
endforeach()

set(_configure "${CMAKE_COMMAND}" -S "${TEST_ROOT}/consumer"
    "-DCMAKE_PREFIX_PATH=${_prefix}" "-DCMAKE_BUILD_TYPE=${CONFIG}"
    "-DCMAKE_CONFIGURATION_TYPES=${CONFIG}" "-DTorch_DIR=${Torch_DIR}"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF)
foreach(_pair "COMPILER|CMAKE_CXX_COMPILER" "CXX_FLAGS|CMAKE_CXX_FLAGS" "EXE_LINKER_FLAGS|CMAKE_EXE_LINKER_FLAGS"
    "COMPILER_LAUNCHER|CMAKE_CXX_COMPILER_LAUNCHER")
    string(REPLACE "|" ";" _parts "${_pair}")
    list(GET _parts 0 _input)
    list(GET _parts 1 _output)
    if(DEFINED ${_input} AND NOT "${${_input}}" STREQUAL "")
        list(APPEND _configure "-D${_output}=${${_input}}")
    endif()
endforeach()
if(GENERATOR)
    list(APPEND _configure -G "${GENERATOR}")
endif()
if(WIN32 AND Torch_DIR)
    get_filename_component(_torch_prefix "${Torch_DIR}/../../.." ABSOLUTE)
    set(ENV{PATH} "${_torch_prefix}/lib;$ENV{PATH}")
endif()
run_checked(${_configure} -B "${TEST_ROOT}/consumer-build")
run_checked("${CMAKE_COMMAND}" --build "${TEST_ROOT}/consumer-build" --config "${CONFIG}" --parallel "${JOBS}")
run_checked("${CMAKE_CTEST_COMMAND}" --test-dir "${TEST_ROOT}/consumer-build" -C "${CONFIG}"
    --parallel "${JOBS}" --output-on-failure)

function(expect_rejected name expected)
    execute_process(COMMAND ${_configure} -B "${TEST_ROOT}/reject-${name}" ${ARGN}
        RESULT_VARIABLE _status OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(_status EQUAL 0)
        message(FATAL_ERROR "SDK accepted incompatible ${name}")
    endif()
    if(NOT "${_out}\n${_err}" MATCHES "${expected}")
        message(FATAL_ERROR "SDK ${name} failed for unexpected reason:\n${_out}\n${_err}")
    endif()
endfunction()
expect_rejected(version "version: 0.1.0|version.*0.1.0" -DSDK_TEST_VERSION=0.1.1)
expect_rejected(abi "requested TORCH_ABI mismatch" -DAlphaDiamondEngine_EXPECT_TORCH_ABI=invalid)
if(WIN32)
    expect_rejected(standard "requires C\\+\\+26" -DCMAKE_CXX_STANDARD=20)
else()
    expect_rejected(standard "requires C\\+\\+26" -DCMAKE_CXX_STANDARD=23)
endif()
string(JSON _platform GET "${_manifest}" platform)
if(_platform STREQUAL "Linux")
    string(JSON _abi GET "${_manifest}" torch_abi)
    set(_wrong_abi 0)
    if(_abi STREQUAL "cxx11-0")
        set(_wrong_abi 1)
    endif()
    expect_rejected(consumer-abi "consumer C\\+\\+ ABI mismatch"
        "-DCMAKE_CXX_FLAGS=-D_GLIBCXX_USE_CXX11_ABI=${_wrong_abi}")
endif()
expect_rejected(variant "requested TORCH_VARIANT mismatch" -DAlphaDiamondEngine_EXPECT_TORCH_VARIANT=invalid)
if(CONFIG STREQUAL "Debug")
    set(_wrong_config Release)
else()
    set(_wrong_config Debug)
endif()
expect_rejected(configuration "configuration mismatch"
    "-DCMAKE_BUILD_TYPE=${_wrong_config}" "-DCMAKE_CONFIGURATION_TYPES=${_wrong_config}")
message(STATUS "Relocated SDK consumer and incompatibility checks passed: ${TEST_ROOT}")
