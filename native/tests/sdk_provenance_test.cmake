cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/sdk_test_toolchain.cmake")
set(_root "${TEST_ROOT}/sdk-provenance")
set(_source "${_root}/source")
set(_build "${_root}/build")
file(MAKE_DIRECTORY "${_source}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE _status OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(NOT _status EQUAL 0)
        message(FATAL_ERROR "Provenance regression failed: ${ARGV}\n${_out}\n${_err}")
    endif()
endfunction()
file(WRITE "${_source}/private.hpp" "constexpr int sdk_delta = 0;\n")
file(WRITE "${_source}/core.cpp" "#include \"private.hpp\"\nint sdk_value() { return 1 + sdk_delta; }\n")
file(WRITE "${_source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.30)
project(SdkProvenanceRegression LANGUAGES CXX)
include("${ENGINE_SOURCE}/cmake/AlphaDiamondEngineBuildProvenance.cmake")
add_library(core STATIC core.cpp)
alphadiamond_engine_track_provenance(TARGETS core INPUTS "${PROJECT_SOURCE_DIR}/core.cpp" "${PROJECT_SOURCE_DIR}/CMakeLists.txt")
install(TARGETS core ARCHIVE DESTINATION lib COMPONENT Runtime)
set(ALPHADIAMOND_ENGINE_VERSION 0.1.0)
set(CMAKE_INSTALL_DATADIR share)
configure_file("${ENGINE_SOURCE}/cmake/AlphaDiamondEngineManifest.cmake.in" "${PROJECT_BINARY_DIR}/manifest.cmake" @ONLY)
install(SCRIPT "${PROJECT_BINARY_DIR}/manifest.cmake" COMPONENT Runtime)
]=])
checked(git -C "${_source}" init -q)
checked(git -C "${_source}" add .)
checked(git -C "${_source}" -c user.name=SdkTest -c user.email=sdk-test@example.invalid commit -qm A)
checked("${CMAKE_COMMAND}" -S "${_source}" -B "${_build}"
    "-DENGINE_SOURCE=${SOURCE_DIR}" ${_sdk_configure_options})
function(build_install name)
    checked("${CMAKE_COMMAND}" --build "${_build}" --config "${CONFIG}" --parallel "${JOBS}")
    checked("${CMAKE_COMMAND}" --install "${_build}" --component Runtime --prefix "${_root}/${name}" --config "${CONFIG}")
    file(READ "${_root}/${name}/share/AlphaDiamondEngine/manifest.json" _manifest)
    file(GLOB _archives "${_root}/${name}/lib/*")
    list(GET _archives 0 _archive_path)
    get_filename_component(_archive "${_archive_path}" NAME)
    set(_archive "${_archive}" PARENT_SCOPE)
    set(MANIFEST "${_manifest}" PARENT_SCOPE)
endfunction()
function(reject_install expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${_build}" --component Runtime
        --prefix "${_root}/stale" --config "${CONFIG}" RESULT_VARIABLE _status OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(_status EQUAL 0 OR NOT "${_out}\n${_err}" MATCHES "${expected}")
        message(FATAL_ERROR "Stale install was not rejected as expected:\n${_out}\n${_err}")
    endif()
    if(EXISTS "${_root}/stale/lib")
        message(FATAL_ERROR "Install copied binaries before rejecting stale provenance")
    endif()
endfunction()
build_install(clean-a)
string(JSON _clean GET "${MANIFEST}" source_dirty)
string(JSON _sha_a GET "${MANIFEST}" source_sha)
string(JSON _content_a GET "${MANIFEST}" source_content_sha256)
string(JSON _binary_a GET "${MANIFEST}" files "lib/${_archive}")
if(_clean)
    message(FATAL_ERROR "Clean commit A was marked dirty")
endif()
file(WRITE "${_source}/core.cpp" "#include \"private.hpp\"\nint sdk_value() { return 2 + sdk_delta; }\n")
build_install(edited-a)
string(JSON _dirty GET "${MANIFEST}" source_dirty)
string(JSON _content_edit GET "${MANIFEST}" source_content_sha256)
string(JSON _binary_edit GET "${MANIFEST}" files "lib/${_archive}")
if(NOT _dirty OR _content_edit STREQUAL _content_a OR _binary_edit STREQUAL _binary_a)
    message(FATAL_ERROR "Incremental build did not refresh edited source provenance")
endif()
checked(git -C "${_source}" add core.cpp)
checked(git -C "${_source}" -c user.name=SdkTest -c user.email=sdk-test@example.invalid commit -qm B)
reject_install("SDK source changed since its build")
build_install(clean-b)
string(JSON _clean GET "${MANIFEST}" source_dirty)
string(JSON _sha_b GET "${MANIFEST}" source_sha)
if(_clean OR _sha_a STREQUAL _sha_b)
    message(FATAL_ERROR "Incremental build retained commit A provenance after commit B")
endif()
file(WRITE "${_source}/core.cpp" "#include \"private.hpp\"\nint sdk_value() { return 3 + sdk_delta; }\n")
reject_install("SDK source changed since its build")
checked("${CMAKE_COMMAND}" --build "${_build}" --config "${CONFIG}" --parallel "${JOBS}")
# The preceding build is already dirty. A private-header edit must change the
# content fingerprint even though the dirty boolean remains true.
file(WRITE "${_source}/private.hpp" "constexpr int sdk_delta = 1;\n")
reject_install("SDK source changed since its build")
checked("${CMAKE_COMMAND}" --build "${_build}" --config "${CONFIG}" --parallel "${JOBS}")
file(READ "${_build}/sdk-build-provenance/${CONFIG}/stamp.json" _stamp)
string(JSON _binary_path MEMBER "${_stamp}" binaries 0)
file(APPEND "${_binary_path}" "tamper")
reject_install("SDK binary changed since its build")
message(STATUS "Build-stamped provenance and stale-install rejection passed")
